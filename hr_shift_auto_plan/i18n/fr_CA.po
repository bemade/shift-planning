#. module: hr_shift_auto_plan
#. odoo-python
#: code:addons/hr_shift_auto_plan/models/shift_planning.py:0
msgid ""
" %(overloaded)s assignment(s) exceed contract hours — no lighter candidate "
"was available; see the cascades."
msgstr ""
" %(overloaded)s assignation(s) dépassent les heures du contrat — aucune "
"candidate moins chargée n'était disponible; voir les cascades."

#. module: hr_shift_auto_plan
#. odoo-python
#: code:addons/hr_shift_auto_plan/models/shift_planning.py:0
msgid ""
"Assigned to %(employee)s %(overshoot).2f h beyond their contract hours: no "
"candidate had room left and this is the smallest possible excess."
msgstr ""
"Assigné à %(employee)s %(overshoot).2f h au-delà de ses heures de contrat : "
"aucune candidate n'avait de place et c'est le plus petit dépassement "
"possible."

