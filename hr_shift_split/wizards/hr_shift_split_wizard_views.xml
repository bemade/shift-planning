<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_shift_split_wizard_form" model="ir.ui.view">
        <field name="model">hr.shift.split.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="line_id" invisible="gap_id" readonly="1" />
                    <field name="gap_id" invisible="line_id" readonly="1" />
                    <field name="template_id" />
                    <field name="planning_id" />
                    <field name="cut_time" widget="float_time" />
                </group>
                <footer>
                    <button
                        type="object"
                        name="action_split"
                        string="Split and launch replacements"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="hr_shift_split_line_action" model="ir.actions.act_window">
        <field name="name">Split shift</field>
        <field name="res_model">hr.shift.split.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="hr_shift.model_hr_shift_planning_line" />
        <field name="binding_view_types">list,form</field>
        <field name="context">{'default_line_id': active_id}</field>
        <field name="group_ids" eval="[(4, ref('hr_shift.group_shift_manager'))]" />
    </record>
</odoo>
