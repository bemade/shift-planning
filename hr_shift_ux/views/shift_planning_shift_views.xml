<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Shifts of the week: a list that answers the real questions —
         who works, where, on which weekly shift and for how many hours. -->
    <record id="shift_planning_shift_tree" model="ir.ui.view">
        <field name="model">hr.shift.planning.shift</field>
        <field name="inherit_id" ref="hr_shift.shift_planning_shift_tree" />
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-danger">overtime</attribute>
                <attribute name="decoration-muted">not template_id</attribute>
            </xpath>
            <field name="employee_id" position="attributes">
                <attribute name="widget">many2one_avatar_employee</attribute>
            </field>
            <field name="template_id" position="attributes">
                <attribute name="string">Weekly shift</attribute>
            </field>
            <field name="template_id" position="after">
                <field name="department_id" optional="show" />
                <field
                    name="planned_hours"
                    widget="float_time"
                    sum="Total planned"
                    optional="show"
                />
                <field name="allocated_hours" widget="float_time" optional="show" />
                <field name="overtime" optional="show" />
            </field>
        </field>
    </record>
    <record id="shift_planning_shift_search" model="ir.ui.view">
        <field name="model">hr.shift.planning.shift</field>
        <field name="inherit_id" ref="hr_shift.shift_planning_shift_search" />
        <field name="arch" type="xml">
            <field name="planning_id" position="after">
                <field name="department_id" />
                <filter
                    name="filter_no_template"
                    string="Without weekly shift"
                    domain="[('template_id', '=', False)]"
                />
                <group name="group_by">
                    <filter
                        name="group_department"
                        string="Department"
                        context="{'group_by': 'department_id'}"
                    />
                    <filter
                        name="group_template"
                        string="Weekly shift"
                        context="{'group_by': 'template_id'}"
                    />
                </group>
            </field>
        </field>
    </record>
    <!-- Open the shifts of a week on the list, grouped by department,
         instead of a kanban dominated by the "None" column. -->
    <record id="hr_shift.shift_planning_shift_action" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form</field>
        <field
            name="context"
        >{'default_planning_id': active_id, 'search_default_group_department': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No shift for this week yet</p>
            <p
            >Go back to the planning and press "1. Create the week shifts": one line per employee will show up here.</p>
        </field>
    </record>
</odoo>
