<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Keep the top bar for daily work; move the setup screens under a
         single Configuration menu. -->
    <menuitem
        id="menu_shift_configuration"
        name="Configuration"
        parent="hr_shift.shift_planning_root"
        sequence="90"
        groups="hr_shift.group_shift_manager"
    />
    <record id="hr_shift.shift_template_menu" model="ir.ui.menu">
        <field name="name">Shift templates</field>
        <field name="parent_id" ref="hr_shift_ux.menu_shift_configuration" />
        <field name="sequence">10</field>
    </record>
    <record id="hr_shift_coverage.hr_shift_coverage_rule_menu" model="ir.ui.menu">
        <field name="parent_id" ref="hr_shift_ux.menu_shift_configuration" />
        <field name="sequence">20</field>
    </record>
    <record id="hr_shift_rotation.hr_shift_rotation_menu" model="ir.ui.menu">
        <field name="parent_id" ref="hr_shift_ux.menu_shift_configuration" />
        <field name="sequence">30</field>
    </record>
</odoo>
