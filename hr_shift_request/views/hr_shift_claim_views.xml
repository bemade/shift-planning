<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_shift_claim_form" model="ir.ui.view">
        <field name="model">hr.shift.claim</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_approve"
                        type="object"
                        string="Approve"
                        class="btn-primary"
                        invisible="state != 'submitted'"
                        groups="hr_shift.group_shift_manager"
                    />
                    <button
                        name="action_refuse"
                        type="object"
                        string="Refuse"
                        invisible="state != 'submitted'"
                        groups="hr_shift.group_shift_manager"
                    />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        invisible="state != 'submitted'"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field
                                name="employee_id"
                                widget="many2one_avatar_employee"
                            />
                            <field name="planning_id" />
                        </group>
                        <group>
                            <field name="template_id" />
                            <field name="day_number" />
                            <field name="line_id" invisible="not line_id" />
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <record id="hr_shift_claim_tree" model="ir.ui.view">
        <field name="model">hr.shift.claim</field>
        <field name="arch" type="xml">
            <list
                decoration-success="state == 'approved'"
                decoration-muted="state in ('refused', 'cancelled')"
            >
                <field name="employee_id" widget="many2one_avatar_employee" />
                <field name="planning_id" />
                <field name="template_id" />
                <field name="day_number" />
                <field name="state" widget="badge" />
            </list>
        </field>
    </record>
    <record id="hr_shift_claim_search" model="ir.ui.view">
        <field name="model">hr.shift.claim</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id" />
                <field name="planning_id" />
                <filter
                    name="filter_submitted"
                    string="To Approve"
                    domain="[('state', '=', 'submitted')]"
                />
                <group name="group_by">
                    <filter
                        name="group_planning"
                        string="Planning"
                        context="{'group_by': 'planning_id'}"
                    />
                    <filter
                        name="group_state"
                        string="Status"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="hr_shift_claim_action" model="ir.actions.act_window">
        <field name="name">Open Shift Claims</field>
        <field name="res_model">hr.shift.claim</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No open shift claim yet
            </p>
            <p>
                Employees claim open shifts from the coverage gaps of a
                planning; shift managers approve them here.
            </p>
        </field>
    </record>
    <menuitem
        id="hr_shift_claim_menu"
        name="Open Shift Claims"
        parent="hr_shift.shift_planning_root"
        action="hr_shift_claim_action"
        sequence="50"
    />
</odoo>
