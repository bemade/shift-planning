<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_shift_availability_rule_own" model="ir.rule">
        <field name="name">Own shift availabilities</field>
        <field name="model_id" ref="model_hr_shift_availability" />
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>
    <record id="hr_shift_availability_rule_manager" model="ir.rule">
        <field name="name">All shift availabilities</field>
        <field name="model_id" ref="model_hr_shift_availability" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_shift.group_shift_manager'))]" />
    </record>
    <record id="hr_shift_claim_rule_own" model="ir.rule">
        <field name="name">Own shift claims</field>
        <field name="model_id" ref="model_hr_shift_claim" />
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>
    <record id="hr_shift_claim_rule_manager" model="ir.rule">
        <field name="name">All shift claims</field>
        <field name="model_id" ref="model_hr_shift_claim" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_shift.group_shift_manager'))]" />
    </record>
    <record id="hr_shift_swap_rule_own" model="ir.rule">
        <field name="name">Own shift swaps</field>
        <field name="model_id" ref="model_hr_shift_swap" />
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id),
            ('target_employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>
    <record id="hr_shift_swap_rule_manager" model="ir.rule">
        <field name="name">All shift swaps</field>
        <field name="model_id" ref="model_hr_shift_swap" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_shift.group_shift_manager'))]" />
    </record>
</odoo>
