<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="shift_planning_form" model="ir.ui.view">
        <field name="model">hr.shift.planning</field>
        <field name="inherit_id" ref="hr_shift.shift_planning_form" />
        <field name="arch" type="xml">
            <button name="generate_shifts" position="after">
                <button
                    type="object"
                    name="action_publish"
                    string="Publish"
                    class="btn btn-secondary"
                    invisible="state == 'new'"
                    groups="hr_shift.group_shift_manager"
                />
            </button>
        </field>
    </record>
</odoo>
