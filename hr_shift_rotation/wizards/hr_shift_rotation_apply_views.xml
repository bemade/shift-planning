<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_shift_rotation_apply_form" model="ir.ui.view">
        <field name="model">hr.shift.rotation.apply</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="rotation_id" />
                    <field name="year" />
                    <field name="week_from" />
                    <field name="week_count" />
                    <field name="overwrite" />
                </group>
                <footer>
                    <button
                        name="action_apply"
                        type="object"
                        string="Apply Rotation"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="hr_shift_rotation_apply_action" model="ir.actions.act_window">
        <field name="name">Apply Rotation</field>
        <field name="res_model">hr.shift.rotation.apply</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem
        id="hr_shift_rotation_apply_menu"
        name="Apply Rotation"
        parent="hr_shift.shift_planning_root"
        action="hr_shift_rotation_apply_action"
        sequence="36"
        groups="hr_shift.group_shift_manager"
    />
</odoo>
